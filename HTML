<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lívia Gregoski Beauty</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="css/style.css">

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

        <div class="container">

            <a class="navbar-brand fw-bold text-danger" href="#">
                💗 Lívia Gregoski Beauty
            </a>

            <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#sobre">Sobre</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#servicos">Serviços</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#galeria">Galeria</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contato">Contato</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- Banner -->

    <section id="home" class="container text-center py-5">

        <img src="assets/imagens/banner.jpg"
             class="img-fluid rounded shadow mb-4"
             alt="Banner">

        <h1 class="display-4">
            Realce sua beleza com um olhar inesquecível ✨
        </h1>

        <p class="lead">

            Alongamento de cílios com acabamento delicado,
            confortável e duradouro.

        </p>

        <a href="#contato" class="btn btn-danger btn-lg">
            Agendar Horário
        </a>

    </section>

    <!-- Sobre -->

    <section id="sobre" class="container py-5">

        <div class="row align-items-center">

            <div class="col-md-5">

                <img src="assets/imagens/livia.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-7">

                <h2>Sobre Mim</h2>

                <p>

                    Olá! Meu nome é Lívia Gregoski e sou Lash Designer.
                    Trabalho com técnicas modernas de extensão de cílios,
                    oferecendo um atendimento personalizado para valorizar
                    a beleza natural de cada cliente.

                </p>

            </div>

        </div>

    </section>

    <!-- Serviços -->

    <section id="servicos" class="container py-5">

        <h2 class="text-center mb-5">

            Nossos Serviços

        </h2>

        <div class="row">

            <div class="col-md-4">

                <div class="card shadow">

                    <img src="assets/imagens/brasileiro.jpg"
                        class="card-img-top">

                    <div class="card-body">

                        <h4>Volume Brasileiro</h4>

                        <p>
                            Natural e elegante.
                        </p>

                        <h5>R$ 115,00</h5>

                        <button class="btn btn-outline-danger">
                            Saiba Mais
                        </button>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow">

                    <img src="assets/imagens/fox.jpg"
                        class="card-img-top">

                    <div class="card-body">

                        <h4>Fox Eyes</h4>

                        <p>
                            Efeito alongado.
                        </p>

                        <h5>R$ 115,00</h5>

                        <button class="btn btn-outline-danger">
                            Saiba Mais
                        </button>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow">

                    <img src="assets/imagens/glamour.jpg"
                        class="card-img-top">

                    <div class="card-body">

                        <h4>Volume Glamour</h4>

                        <p>
                            Muito volume e sofisticação.
                        </p>

                        <h5>R$ 115,00</h5>

                        <button class="btn btn-outline-danger">
                            Saiba Mais
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Galeria -->

    <section id="galeria" class="container py-5">

        <h2 class="text-center mb-5">

            Galeria

        </h2>

        <div class="row">

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto1.jpg" class="img-fluid rounded shadow">
            </div>

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto2.jpg" class="img-fluid rounded shadow">
            </div>

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto3.jpg" class="img-fluid rounded shadow">
            </div>

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto4.jpg" class="img-fluid rounded shadow">
            </div>

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto5.jpg" class="img-fluid rounded shadow">
            </div>

            <div class="col-md-4 mb-3">
                <img src="assets/imagens/foto6.jpg" class="img-fluid rounded shadow">
            </div>

        </div>

    </section>

    <!-- Contato -->

    <section id="contato" class="container py-5">

        <h2 class="text-center mb-4">

            Entre em Contato

        </h2>

        <form>

            <input
                type="text"
                class="form-control mb-3"
                placeholder="Nome">

            <input
                type="email"
                class="form-control mb-3"
                placeholder="Email">

            <textarea
                class="form-control mb-3"
                rows="5"
                placeholder="Mensagem"></textarea>

            <button class="btn btn-danger">
                Enviar
            </button>

        </form>

        <div class="text-center mt-5">

            <h5>Redes Sociais</h5>

            <p>

                📸 Instagram:
                @liviagrk_beauty

            </p>

            <p>

                📱 WhatsApp:
                (41) 99999-9999

            </p>

        </div>

    </section>

    <!-- Rodapé -->

    <footer class="bg-light text-center p-4">

        <p>

            © 2026 Lívia Gregoski Beauty

        </p>

    </footer>

    <!-- Bootstrap -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JavaScript -->

    <script src="script.js"></script>

</body>

</html>
