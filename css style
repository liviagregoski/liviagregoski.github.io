/* Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap');

/* ========================= */
/* CONFIGURAÇÕES GERAIS */
/* ========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#fffafc;
    color:#555;
}

/* ========================= */
/* NAVBAR */
/* ========================= */

.navbar{
    background:white !important;
}

.navbar-brand{
    font-family:'Playfair Display',serif;
    font-size:28px;
    color:#d96b93 !important;
    font-weight:bold;
}

.nav-link{
    color:#666 !important;
    margin-left:20px;
    transition:.3s;
}

.nav-link:hover{
    color:#d96b93 !important;
}

/* ========================= */
/* HERO */
/* ========================= */

.hero{

    background:linear-gradient(135deg,#fde8ef,#ffffff);

    padding-top:150px;
    padding-bottom:100px;

}

.hero h1{

    font-family:'Playfair Display',serif;

    font-size:55px;

    color:#b86b77;

    margin-bottom:20px;

}

.hero p{

    font-size:18px;

    margin-bottom:30px;

}

.hero img{

    width:90%;

}

/* ========================= */
/* BOTÃO */
/* ========================= */

.btn-rosa{

    background:#f5a9c5;

    color:white;

    border:none;

    padding:12px 35px;

    border-radius:50px;

    transition:.4s;

    font-weight:600;

}

.btn-rosa:hover{

    background:#d88aa7;

    transform:translateY(-3px);

    color:white;

}

/* ========================= */
/* TÍTULOS */
/* ========================= */

h2{

    font-family:'Playfair Display',serif;

    color:#c98b3d;

    margin-bottom:30px;

    text-align:center;

}

/* ========================= */
/* SOBRE */
/* ========================= */

#sobre{

    padding-top:90px;

    padding-bottom:90px;

}

#sobre img{

    border-radius:20px;

}

#sobre p{

    line-height:30px;

    font-size:17px;

}

/* ========================= */
/* CARDS */
/* ========================= */

.card{

    border:none;

    border-radius:20px;

    overflow:hidden;

    transition:.4s;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

}

.card:hover{

    transform:translateY(-10px);

}

.card img{

    height:280px;

    object-fit:cover;

}

.card-body{

    padding:25px;

}

.card h4{

    color:#c98b3d;

}

.card h5{

    color:#d96b93;

    font-weight:bold;

}

/* ========================= */
/* GALERIA */
/* ========================= */

#galeria img{

    border-radius:20px;

    transition:.4s;

    cursor:pointer;

}

#galeria img:hover{

    transform:scale(1.05);

    box-shadow:0 15px 35px rgba(0,0,0,.15);

}

/* ========================= */
/* CONTATO */
/* ========================= */

#contato{

    padding-bottom:100px;

}

.form-control{

    border-radius:15px;

    border:1px solid #f3c7d8;

    padding:15px;

}

.form-control:focus{

    border-color:#d96b93;

    box-shadow:0 0 10px rgba(217,107,147,.3);

}

#contato h5{

    color:#c98b3d;

}

#contato p{

    font-size:18px;

}

/* ========================= */
/* RODAPÉ */
/* ========================= */

footer{

    background:#f8dce7;

    text-align:center;

    padding:30px;

    color:#7d5864;

}

/* ========================= */
/* RESPONSIVO */
/* ========================= */

@media(max-width:768px){

.hero{

text-align:center;

padding-top:120px;

}

.hero h1{

font-size:38px;

}

.hero img{

margin-top:40px;

width:100%;

}

.navbar-brand{

font-size:22px;

}

}
